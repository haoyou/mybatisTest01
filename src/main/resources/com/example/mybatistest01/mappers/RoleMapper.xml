<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mybatistest01.mappers.RoleMapper">
    <resultMap id="roleResultMap" type="com.example.mybatistest01.entity.Role">
        <id property="id" column="id" />
        <result property="roleName" column="role_name" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>
    <sql id="role_column">id, role_name, create_by, create_time, update_by, update_time</sql>

    <insert id="insertRole">
        insert into role(<include refid="role_column"/>) values(#{id},#{roleName},#{createBy},#{createTime},#{updateBy},#{updateTime})
    </insert>

    <select id="getRoleList" resultMap="roleResultMap">
        select <include refid="role_column"/> from role
    </select>
    <select id="getRoleById" resultMap="roleResultMap">
        select
        <include refid="role_column"/>
        from role where id = #{id}
    </select>
    <select id="getRoleByName" resultMap="roleResultMap">
        select
            <include refid="role_column"/>
        from role where role_name = #{roleName}
    </select>


</mapper>
